# Stackable git push shorthand.
# Examples:
#   push
#   push origin HEAD
#   push u origin HEAD
#   push nv
#   push lease
#   push nv lease
#   push dry nv lease origin HEAD
push() {
  local -a git_args
  local -a push_flags
  local arg

  for arg in "$@"; do
    case "$arg" in
      nv|--nv)
        push_flags+=(--no-verify)
        ;;
      lease|ff|force-with-lease|--force-with-lease)
        push_flags+=(--force-with-lease)
        ;;
      f|force|--force)
        echo "Refusing unsafe force shorthand. Use 'lease' or 'ff' for --force-with-lease."
        return 1
        ;;
      tags|--tags)
        push_flags+=(--tags)
        ;;
      u|upstream|track)
        push_flags+=(-u)
        ;;
      dry|dry-run|--dry-run)
        push_flags+=(--dry-run)
        ;;
      *)
        git_args+=("$arg")
        ;;
    esac
  done

  git push "${push_flags[@]}" "${git_args[@]}"
}

