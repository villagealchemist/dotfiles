ai-keychain-env-args() {
  local -a envArgs
  local githubToken
  local arg

  githubToken="$(keychain-get github.com 2>/dev/null)" || githubToken=""

  if [[ -n "$githubToken" ]]; then
    envArgs+=("GITHUB_TOKEN=$githubToken")
    envArgs+=("NPM_TOKEN=$githubToken")
    envArgs+=("CHANGELOG_GITHUB_TOKEN=$githubToken")
  fi

  arg="$(keychain-env-arg-if-present OPENAI_API_KEY OPENAI_API_KEY)" && [[ -n "$arg" ]] && envArgs+=("$arg")
  arg="$(keychain-env-arg-if-present GEMINI_API_KEY GEMINI_API_KEY)" && [[ -n "$arg" ]] && envArgs+=("$arg")
  arg="$(keychain-env-arg-if-present GOOGLE_API_KEY GOOGLE_API_KEY)" && [[ -n "$arg" ]] && envArgs+=("$arg")
  arg="$(keychain-env-arg-if-present ANTHROPIC_API_KEY ANTHROPIC_API_KEY)" && [[ -n "$arg" ]] && envArgs+=("$arg")

  print -rl -- "${envArgs[@]}"
}

gemini() {
  local -a envArgs
  local exitCode
  local envOutput

  envOutput="$(ai-keychain-env-args)"
  [[ -n "$envOutput" ]] && envArgs=("${(@f)envOutput}")
  echo -ne "\033]0;gemini\007"

  if (( ${#envArgs[@]} )); then
    command env "${envArgs[@]}" gemini "$@"
    exitCode=$?
  else
    command gemini "$@"
    exitCode=$?
  fi

  echo -ne "\033]0;zsh\007"
  return $exitCode
}

