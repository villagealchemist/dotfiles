  echo

  codex exec --sandbox workspace-write "$prompt"
}

# ───────────────────────────────────────────────────────────────
# 🔑 KEYCHAIN + LAZY CREDENTIAL HELPERS
# ───────────────────────────────────────────────────────────────
# Rules:
# - Do not auto-source ~/.env.private.
# - Do not hardcode secrets here.
# - Explicit `use-*` helpers export into the current shell.
# - Wrappers inject secrets only into child processes when possible.

source "$HOME/.config/keychain/helpers.zsh"

require-keychain() {
  local var="$1"
  local service="$2"
  local value

  [[ -n "$var" && -n "$service" ]] || {
    print -u2 "usage: require-keychain <ENV_VAR> <keychain-service>"
    return 1
  }

  value="$(keychain-get "$service")" || {
    print -u2 "Keychain item missing or inaccessible: $service"
    return 1
  }

  [[ -n "$value" ]] || {
    print -u2 "empty Keychain item: $service"
    return 1
  }

  export "$var=$value"
}

export-keychain-if-present() {
  local var="$1"
  local service="$2"
  local value

  [[ -n "$var" && -n "$service" ]] || return 0

  value="$(keychain-get "$service" 2>/dev/null)" || return 0
  [[ -n "$value" ]] || return 0

  export "$var=$value"
}

export-keychain-first-present() {
  local var="$1"
  shift

  local service
  for service in "$@"; do
    export-keychain-if-present "$var" "$service"
    [[ -n "${(P)var}" ]] && return 0
  done

  return 0
}

keychain-env-arg-if-present() {
  local var="$1"
  local service="$2"
  local value

  [[ -n "$var" && -n "$service" ]] || return 0

  value="$(keychain-get "$service" 2>/dev/null)" || return 0
  [[ -n "$value" ]] || return 0

  print -r -- "$var=$value"
}

keychain-env-arg-first-present() {
  local var="$1"
  shift

  local service
  local arg
  for service in "$@"; do
    arg="$(keychain-env-arg-if-present "$var" "$service")" || arg=""
    if [[ -n "$arg" ]]; then
      print -r -- "$arg"
      return 0
    fi
  done

  return 0
}

