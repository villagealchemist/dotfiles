typeset -U path PATH

path_prepend() {
  [[ -n "$1" && -d "$1" ]] || return 0
  path=("$1" "${path[@]}")
}

path_append() {
  [[ -n "$1" && -d "$1" ]] || return 0

  local -a updated_path
  local entry
  for entry in "${path[@]}"; do
    [[ "$entry" == "$1" ]] || updated_path+=("$entry")
  done
  path=("${updated_path[@]}" "$1")
}

