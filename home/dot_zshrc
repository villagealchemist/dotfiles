bincat() {
  [[ -n "$1" ]] || { echo "usage: bincat <script-name>"; return 1; }
  [[ -f "$LOCAL_BIN/$1" ]] || { echo "not found: $LOCAL_BIN/$1"; return 1; }
  bat "$LOCAL_BIN/$1" 2>/dev/null || cat "$LOCAL_BIN/$1"
}

bineditfile() {
  [[ -n "$1" ]] || { echo "usage: bineditfile <script-name>"; return 1; }
  [[ -f "$LOCAL_BIN/$1" ]] || { echo "not found: $LOCAL_BIN/$1"; return 1; }
  chezmoi edit --apply "$LOCAL_BIN/$1"
}

binrun() {
  [[ -n "$1" ]] || { echo "usage: binrun <script-name> [args...]"; return 1; }
  local script="$1"
  shift
  [[ -x "$LOCAL_BIN/$script" ]] || { echo "not executable: $LOCAL_BIN/$script"; return 1; }
  "$LOCAL_BIN/$script" "$@"
}

binwhich() {
  [[ -n "$1" ]] || { echo "usage: binwhich <command>"; return 1; }
  command -v "$1"
}

bincheck() {
  echo "LOCAL_BIN: $LOCAL_BIN"
  echo
  echo "In PATH?"
  case ":$PATH:" in
    *":$LOCAL_BIN:"*) echo "yes" ;;
    *) echo "no" ;;
  esac
  echo
  echo "Contents:"
  ls -la "$LOCAL_BIN" 2>/dev/null || echo "missing: $LOCAL_BIN"
}

binnew() {
  [[ -n "$1" ]] || { echo "usage: binnew <script-name>"; return 1; }

  local file="$LOCAL_BIN/$1"
  local -a editor_command
  mkdir -p "$LOCAL_BIN" || return 1

  if [[ -e "$file" ]]; then
    echo "already exists: $file"
    return 1
  fi

  cat > "$file" <<'SCRIPT'
#!/usr/bin/env zsh
set -euo pipefail
SCRIPT

  chmod +x "$file"
  editor_command=(${(z)EDITOR})
  "${editor_command[@]}" "$file" || return
  chezmoi add "$file"
  echo "managed by chezmoi: $(chezmoi source-path "$file")"
}

