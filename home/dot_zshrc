global-ignore-add() {
  [[ -n "$1" ]] || { echo "usage: global-ignore-add <pattern>"; return 1; }

  local ignore_file
  ignore_file="$(git config --global core.excludesfile)"

  if [[ -z "$ignore_file" ]]; then
    ignore_file="$HOME/.gitignore_global"
    git config --global core.excludesfile "$ignore_file"
  fi

  touch "$ignore_file"

  if grep -Fxq "$1" "$ignore_file"; then
    echo "already ignored globally: $1"
  else
    echo "$1" >> "$ignore_file"
    echo "added global ignore: $1"
  fi
}

