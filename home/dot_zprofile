# ───────────────────────────────────────────────────────────────
# 🌅 @villagealchemist ENVIRONMENT SETUP
# Login-shell config: durable environment, PATH, editor defaults.
# Keep interactive aliases/functions in ~/.zshrc.
# ───────────────────────────────────────────────────────────────

# Locale + editor defaults
export LANG="${LANG:-en_US.UTF-8}"
export EDITOR="${EDITOR:-code --wait}"
export VISUAL="${VISUAL:-code --wait}"
export GIT_EDITOR="${GIT_EDITOR:-code --wait}"

# Optional Homebrew behavior
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_AUTO_UPDATE=1

# Disable AWS CLI pager globally. Harmless even when AWS CLI is not used.
export AWS_PAGER=""

# Browser preference
export BROWSER="${BROWSER:-Google Chrome}"

# ───────────────────────────────────────────────────────────────
# 🛣️ PATH HELPERS
# ───────────────────────────────────────────────────────────────

typeset -U path PATH

path_prepend() {
  [[ -n "$1" && -d "$1" ]] || return 0
  path=("$1" "${path[@]}")
}

path_append() {
  [[ -n "$1" && -d "$1" ]] || return 0

  local -a updated_path
  local entry
  for entry in "${path[@]}"; do
    [[ "$entry" == "$1" ]] || updated_path+=("$entry")
  done
  path=("${updated_path[@]}" "$1")
}

# System/user binary paths
path_prepend "/usr/local/bin"
path_prepend "$HOME/bin"
path_prepend "$HOME/.local/bin"
path_append "$HOME/.docker/bin"

# Homebrew priority on Apple Silicon
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  path_prepend "/opt/homebrew/sbin"
  path_prepend "/opt/homebrew/bin"
fi

# Optional Intel Homebrew fallback
if [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
  path_prepend "/usr/local/sbin"
  path_prepend "/usr/local/bin"
fi

# Tool-specific paths
path_prepend "/opt/homebrew/opt/openjdk/bin"
path_append "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
path_append "/Applications/WebStorm.app/Contents/MacOS"
path_append "/Applications/PyCharm CE.app/Contents/MacOS"
path_append "/Applications/darktable.app/Contents/MacOS"

# Python user-local bin paths
for python_dir in "$HOME"/Library/Python/3.*/bin(N/); do
  path_prepend "$python_dir"
done

# Rust / Cargo
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
path_prepend "$PNPM_HOME"

# asdf
export ASDF_DATA_DIR="$HOME/.asdf"
path_prepend "$ASDF_DATA_DIR/shims"

# Proto
export PROTO_HOME="${PROTO_HOME:-$HOME/.proto}"
path_prepend "$PROTO_HOME/shims"
path_prepend "$PROTO_HOME/bin"

# Local script home. Keep this aligned with ~/.zshrc.
export LOCAL_BIN="$HOME/bin"
path_prepend "$LOCAL_BIN"

# Optional identity from macOS Keychain. Create with:
# security add-generic-password -U -a "$USER" -s EMAIL -w "you@example.com"
if command -v security >/dev/null 2>&1; then
  keychain_email="$(security find-generic-password -a "$USER" -s EMAIL -w 2>/dev/null)"
  [[ -n "$keychain_email" ]] && export EMAIL="$keychain_email"
  unset keychain_email
fi

# PATH remains deduplicated by its unique-array attribute.
