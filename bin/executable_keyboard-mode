#!/bin/zsh

# Keep the MacBook keyboard enabled everywhere except the DisplayLink desk setup.
# Manual choices persist until `keyboard-mode auto` is run again.

emulate -L zsh
setopt err_return nounset pipe_fail

readonly KARABINER_CLI="/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_cli"
readonly MODE_FILE="$HOME/.config/karabiner/displaylink-keyboard-mode"
readonly DESK_PROFILE="Desk - MX Keys Mini"
readonly MOBILE_PROFILE="Mobile - Both Keyboards"
readonly DOCK_NAME="Dell Universal Dock D6000"

usage() {
  print -r -- "usage: keyboard-mode [status|auto|both|desk|toggle|sync]"
}

dock_connected() {
  [[ -n "$(/usr/sbin/ioreg -p IOUSB -n "$DOCK_NAME" -r 2>/dev/null)" ]]
}

saved_mode() {
  local mode="both"

  if [[ -r "$MODE_FILE" ]]; then
    IFS= read -r mode < "$MODE_FILE" || mode="both"
  fi

  case "$mode" in
    auto|both|desk) print -r -- "$mode" ;;
    *) print -r -- "both" ;;
  esac
}

save_mode() {
  mkdir -p -- "${MODE_FILE:h}"
  print -r -- "$1" >| "$MODE_FILE"
}

current_profile() {
  "$KARABINER_CLI" --show-current-profile-name 2>/dev/null
}

desired_profile() {
  local mode
  mode="$(saved_mode)"

  case "$mode" in
    desk) print -r -- "$DESK_PROFILE" ;;
    both) print -r -- "$MOBILE_PROFILE" ;;
    auto)
      if dock_connected; then
        print -r -- "$DESK_PROFILE"
      else
        print -r -- "$MOBILE_PROFILE"
      fi
      ;;
  esac
}

sync_profile() {
  local current desired
  desired="$(desired_profile)"
  current="$(current_profile)" || {
    print -u2 -- "keyboard-mode: Karabiner is not available"
    return 1
  }

  if [[ "$current" != "$desired" ]]; then
    "$KARABINER_CLI" --select-profile "$desired"
    print -r -- "keyboard-mode: $desired"
  fi
}

show_status() {
  local dock="disconnected"
  dock_connected && dock="connected"

  print -r -- "Mode:       $(saved_mode)"
  print -r -- "Dock:       $dock"
  print -r -- "Profile:    $(current_profile 2>/dev/null || print -r -- unavailable)"
  print -r -- "Would use:  $(desired_profile)"
}

command_name="${1:-status}"

case "$command_name" in
  status)
    show_status
    ;;
  sync)
    sync_profile
    ;;
  auto|both|desk)
    save_mode "$command_name"
    sync_profile
    show_status
    ;;
  toggle)
    if [[ "$(current_profile 2>/dev/null)" == "$DESK_PROFILE" ]]; then
      save_mode both
    else
      save_mode desk
    fi
    sync_profile
    show_status
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    return 2
    ;;
esac
